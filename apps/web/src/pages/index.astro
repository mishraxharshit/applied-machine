---
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const projects = [
  { tag: "python", name: "tracetune", text: "Turns agent production traces into scored, filtered training data." },
  { tag: "rust", name: "tracecore", text: "Streaming preprocessing for multi-gigabyte trace files." },
  { tag: "go", name: "ingest", text: "A tiny collector service your agents send traces to." },
];
const roadmap = [
  ["v0.1", "traces to scored dataset", true],
  ["v0.2", "Langfuse and OpenTelemetry importers", false],
  ["v0.3", "LoRA recipe with before/after eval report", false],
  ["v0.4", "promote or reject with regression checks", false],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Applied Machine</title>
    <meta name="description" content="Open-source tools that turn agent traces into better models." />
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <div class="orb o1"></div>
    <div class="orb o2"></div>
    <div class="orb o3"></div>
    <div class="grain"></div>

    <main>
      <nav><span class="logo">◐ applied machine</span><span class="dim"><a class="navlink" href={`${base}docs/`}>docs</a> &nbsp;·&nbsp; <a class="navlink" href={`${base}playground/`}>try it live →</a></span></nav>

      <header>
        <p class="eyebrow">// continual improvement for agents</p>
        <h1>Models that learn<br />from their own work.</h1>
        <p class="lede">
          We build open tools that close the loop: production traces in, a better model out,
          shipped only when the evidence says so.
        </p>
      </header>

      <section>
        <h2>01 &nbsp;Systems</h2>
        <div class="cards">
          {projects.map((p) => (
            <article class="glass">
              <span class="chip">{p.tag}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section>
        <h2>02 &nbsp;Roadmap</h2>
        <ul class="glass road">
          {roadmap.map(([v, t, done]) => (
            <li>
              <span class={done ? "dot on" : "dot"}></span>
              <b>{v}</b><span>{t}</span>
            </li>
          ))}
        </ul>
      </section>

      <footer>Applied Machine · Apache-2.0 · built in the open</footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #05060b; --fg: #e8ebf5; --dim: #8b91a8;
    --a: #7c8cff; --b: #c084fc; --c: #5eead4;
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; margin: 0; }
  html { color-scheme: dark; }
  body {
    background: var(--bg); color: var(--fg); font-family: var(--mono);
    line-height: 1.6; min-height: 100vh; overflow-x: hidden;
  }
  .orb {
    position: fixed; border-radius: 50%; filter: blur(90px); opacity: .45;
    pointer-events: none; animation: drift 22s ease-in-out infinite alternate;
  }
  .o1 { width: 46vw; height: 46vw; left: -12vw; top: -14vw; background: var(--a); }
  .o2 { width: 40vw; height: 40vw; right: -10vw; top: 22vh; background: var(--b); animation-delay: -7s; }
  .o3 { width: 34vw; height: 34vw; left: 30vw; bottom: -18vw; background: var(--c); opacity: .3; animation-delay: -14s; }
  @keyframes drift { to { transform: translate(6vw, 5vh) scale(1.12); } }
  .grain {
    position: fixed; inset: 0; pointer-events: none; opacity: .07; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  main { position: relative; max-width: 980px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  nav { display: flex; justify-content: space-between; font-size: .85rem; padding-bottom: 5rem; }
  .logo { letter-spacing: .08em; }
  .dim { color: var(--dim); }
  .navlink { color: var(--c); text-decoration: none; }
  .navlink:hover { text-decoration: underline; }
  .eyebrow { color: var(--c); font-size: .85rem; margin-bottom: 1.2rem; }
  h1 {
    font-size: clamp(2.2rem, 6vw, 4.4rem); line-height: 1.05; font-weight: 500; letter-spacing: -.03em;
    background: linear-gradient(120deg, #fff 20%, var(--a) 60%, var(--b));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lede { max-width: 56ch; color: var(--dim); margin-top: 1.6rem; }
  section { margin-top: 5rem; }
  h2 { font-size: .85rem; font-weight: 400; color: var(--dim); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 1.2rem; }
  .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .glass {
    background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.02));
    border: 1px solid rgba(255,255,255,.12); border-radius: 18px; padding: 1.4rem;
    backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 10px 40px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.15);
    transition: transform .3s ease, border-color .3s ease;
  }
  article.glass:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.28); }
  .chip { font-size: .7rem; color: var(--c); border: 1px solid rgba(94,234,212,.4); border-radius: 99px; padding: .1rem .6rem; }
  h3 { font-weight: 500; font-size: 1.2rem; margin: .9rem 0 .4rem; }
  article p { color: var(--dim); font-size: .9rem; }
  .road { list-style: none; padding: 0; }
  .road li { display: flex; gap: 1rem; align-items: center; padding: .9rem 1.4rem; border-bottom: 1px solid rgba(255,255,255,.07); }
  .road li:last-child { border-bottom: 0; }
  .road b { color: var(--a); font-weight: 500; min-width: 3rem; }
  .road span:last-child { color: var(--dim); }
  .dot { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--dim); }
  .dot.on { background: var(--c); border-color: var(--c); box-shadow: 0 0 12px var(--c); }
  footer { margin-top: 5rem; color: var(--dim); font-size: .8rem; }
  @media (prefers-reduced-motion: reduce) { .orb { animation: none; } article.glass { transition: none; } }
</style>
