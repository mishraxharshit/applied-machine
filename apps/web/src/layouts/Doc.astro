---
import site from "../data/site.json";
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const here = Astro.url.pathname.replace(/\/?$/, "/");
const chapters = [
  { slug: "", title: "Overview" },
  { slug: "architecture/", title: "1. The improvement loop" },
  { slug: "scoring/", title: "2. Scoring and dedup" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} · Applied Machine Docs</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header>
      <a class="logo" href={base}>◐ applied machine</a>
      <span class="ver">docs for v{site.version}</span>
      <nav><a href={`${base}docs/`}>Docs</a><a href={`${base}playground/`}>Playground</a></nav>
    </header>
    <div class="wrap">
      <aside>
        {chapters.map((c) => (
          <a href={`${base}docs/${c.slug}`} class={here === `${base}docs/${c.slug}` ? "active" : ""}>{c.title}</a>
        ))}
      </aside>
      <article class="prose"><slot /></article>
    </div>
    <footer>Documentation for v{site.version}. Updated with every release. Every feature is marked Implemented or Planned.</footer>
    <script is:inline type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.4.0/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: true, theme: "dark" });
    </script>
  </body>
</html>

<style is:global>
  :root { --bg:#05060b; --fg:#e8ebf5; --dim:#8b91a8; --a:#7c8cff; --c:#5eead4; --line:rgba(255,255,255,.12); --mono: ui-monospace,"SF Mono",Menlo,Consolas,monospace; --sans: system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
  * { box-sizing: border-box; margin: 0; }
  html { color-scheme: dark; }
  body { background: radial-gradient(60vw 40vw at 0% -10%, rgba(124,140,255,.25), transparent), var(--bg); color: var(--fg); font-family: var(--sans); line-height: 1.7; }
  header { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: .85rem; flex-wrap: wrap; }
  header a { color: var(--fg); text-decoration: none; }
  .ver { color: var(--c); border: 1px solid rgba(94,234,212,.4); border-radius: 99px; padding: 0 .6rem; font-size: .75rem; }
  header nav { margin-left: auto; display: flex; gap: 1.2rem; }
  header nav a { color: var(--dim); }
  .wrap { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 2.5rem; max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
  aside { display: flex; flex-direction: column; gap: .3rem; font-family: var(--mono); font-size: .82rem; position: sticky; top: 1rem; align-self: start; }
  aside a { color: var(--dim); text-decoration: none; padding: .3rem .6rem; border-radius: 8px; }
  aside a.active, aside a:hover { color: var(--fg); background: rgba(255,255,255,.07); }
  .prose { max-width: 74ch; }
  .prose h1 { font-size: 2rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; margin-bottom: 1rem; }
  .prose h2 { font-size: 1.35rem; margin: 2.2rem 0 .6rem; padding-top: .6rem; border-top: 1px solid var(--line); }
  .prose h3 { font-size: 1.05rem; margin: 1.4rem 0 .4rem; }
  .prose p, .prose ul, .prose ol { margin: .7rem 0; color: #cfd3e4; }
  .prose ul, .prose ol { padding-left: 1.4rem; }
  .prose a { color: var(--a); }
  .prose code { font-family: var(--mono); font-size: .86em; background: rgba(255,255,255,.08); padding: .1em .35em; border-radius: 5px; }
  .prose pre { background: rgba(0,0,0,.4); border: 1px solid var(--line); border-radius: 12px; padding: 1rem; overflow-x: auto; margin: 1rem 0; font-family: var(--mono); font-size: .82rem; line-height: 1.55; }
  .prose pre code { background: none; padding: 0; }
  .prose pre.mermaid { background: rgba(255,255,255,.04); text-align: center; font-family: var(--sans); }
  .prose table { border-collapse: collapse; width: 100%; font-size: .88rem; display: block; overflow-x: auto; margin: 1rem 0; }
  .prose th, .prose td { text-align: left; padding: .45rem .7rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose th { color: var(--dim); font-weight: 500; }
  .prose blockquote, .prose .note { border-left: 3px solid var(--a); background: rgba(124,140,255,.08); padding: .6rem 1rem; border-radius: 0 10px 10px 0; margin: 1rem 0; color: #cfd3e4; }
  .tag { font-family: var(--mono); font-size: .7rem; padding: .05rem .5rem; border-radius: 99px; border: 1px solid; white-space: nowrap; }
  .tag.ok { color: var(--c); border-color: rgba(94,234,212,.5); }
  .tag.plan { color: #f5c26b; border-color: rgba(245,194,107,.5); }
  footer { max-width: 1100px; margin: 0 auto; padding: 1rem 1.5rem 3rem; color: var(--dim); font-size: .8rem; font-family: var(--mono); }
  @media (max-width: 760px) { .wrap { grid-template-columns: 1fr; } aside { position: static; flex-direction: row; flex-wrap: wrap; } }
</style>
